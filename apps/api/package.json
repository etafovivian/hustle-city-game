{
  "name": "@hc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hc/db": "workspace:*",
    "@hc/shared": "workspace:*",
    "fastify": "5.12.5",
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "fastify-plugin": "6.0.1",
    "zod": "4.6.5",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "postgres": "3.4.9"
  }
}

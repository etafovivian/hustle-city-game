    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one gold action per region, with the soft gold glow.",
      "html": "<button class=\"ds-btn-primary\">Serve for 1,200</button>",
      "css": ".ds-btn-primary{font-family:\"Outfit Variable\",\"Outfit\",system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:10px 18px;border-radius:999px;border:1px solid var(--yellow,#ffc72c);background:var(--yellow,#ffc72c);color:var(--yellow-ink,#0a0f24);font-size:16px;font-weight:650;cursor:pointer;box-shadow:0 10px 28px -8px rgb(255 199 44 / 45%);transition:background .15s ease,transform .15s cubic-bezier(.16,1,.3,1)}.ds-btn-primary:hover{background:var(--yellow-hover,#e6b020);border-color:var(--yellow-hover,#e6b020)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:3px solid #ffc72c;outline-offset:2px}.ds-btn-primary:disabled{background:#182042;border-color:#27325c;color:#9aa6c8;box-shadow:none;cursor:not-allowed}"
    },
    {
      "name": "Call to Action (XL)",
      "kind": "button",
      "refersTo": "button-cta-xl",
      "description": "Full-width welcome submit: heavy uppercase gold.",
      "html": "<button class=\"ds-btn-cta\">Start hustling in Junction 101 <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg></button>",
      "css": ".ds-btn-cta{font-family:\"Outfit Variable\",\"Outfit\",system-ui,sans-serif;display:flex;width:100%;align-items:center;justify-content:center;gap:8px;min-height:58px;padding:10px 18px;border-radius:18px;border:1px solid #ffc72c;background:#ffc72c;color:#0a0f24;font-size:17px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap;cursor:pointer;box-shadow:0 10px 28px -8px rgb(255 199 44 / 45%);transition:background .15s ease,transform .15s cubic-bezier(.16,1,.3,1)}.ds-btn-cta:hover{background:#e6b020;border-color:#e6b020;transform:translateY(-1px)}.ds-btn-cta:active{transform:translateY(1px)}.ds-btn-cta:focus-visible{outline:3px solid #ffc72c;outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Default navy pill for every non-primary action.",
      "html": "<button class=\"ds-btn\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg> Find a business</button>",
      "css": ".ds-btn{font-family:\"Outfit Variable\",\"Outfit\",system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:10px 18px;border-radius:999px;border:1px solid #34406f;background:#121835;color:#f1f4ff;font-size:16px;font-weight:650;cursor:pointer;transition:background .15s ease,transform .15s cubic-bezier(.16,1,.3,1)}.ds-btn:hover{background:#182042}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid #ffc72c;outline-offset:2px}"
    },
    {
      "name": "Welcome Input Well",
      "kind": "input",
      "refersTo": "input-well",
      "description": "Uppercase tracked label over a deep navy well; gold focus.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Nickname</span><span class=\"ds-well\"><span class=\"ds-prefix\">@</span><input class=\"ds-input\" placeholder=\"lagos_baller\"></span></label>",
      "css": ".ds-field{font-family:\"Outfit Variable\",\"Outfit\",system-ui,sans-serif;display:grid;gap:6px;color:#f1f4ff}.ds-field-label{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#c9d1ea}.ds-well{position:relative;display:flex;align-items:center}.ds-prefix{position:absolute;left:14px;color:#9aa6c8;font-weight:700}.ds-input{font-family:\"Outfit Variable\",\"Outfit\",system-ui,sans-serif;width:100%;min-height:50px;padding:10px 12px 10px 34px;border-radius:14px;border:1px solid #27325c;background:#182042;color:#f1f4ff;font-size:16px;font-weight:500}.ds-input::placeholder{color:#9aa6c8;font-weight:400}.ds-input:focus-visible{outline:2px solid #ffc72c;outline-offset:0;border-color:transparent}"
    },
    {
      "name": "Segmented Tabs",
      "kind": "nav",
      "refersTo": "segmented-selected",
      "description": "Pill track; the selected tab fills gold.",
      "html": "<div class=\"ds-seg\" role=\"tablist\"><button role=\"tab\" aria-selected=\"true\">My shop</button><button role=\"tab\" aria-selected=\"false\">Real businesses</button></div>",
      "css": ".ds-seg{font-family:\"Outfit Variable\",\"Outfit\",system-ui,sans-serif;display:inline-grid;grid-auto-flow:column;gap:4px;padding:4px;border-radius:999px;background:#182042}.ds-seg button{font-family:\"Outfit Variable\",\"Outfit\",system-ui,sans-serif;border:0;background:transparent;border-radius:999px;padding:8px 16px;min-height:40px;font-size:16px;font-weight:650;color:#9aa6c8;cursor:pointer}.ds-seg button:hover{color:#f1f4ff}.ds-seg button[aria-selected=true]{background:#ffc72c;color:#0a0f24;box-shadow:0 1px 2px rgb(0 0 0 / 40%),0 14px 32px -12px rgb(0 0 0 / 65%)}.ds-seg button:focus-visible{outline:3px solid #ffc72c;outline-offset:2px}"
    },
    {
      "name": "Category Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Navy pill filter; pressed fills gold.",
      "html": "<span class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">Food</button><button class=\"ds-chip\" aria-pressed=\"false\">Fashion</button></span>",
      "css": ".ds-chips{display:inline-flex;gap:8px}.ds-chip{font-family:\"Outfit Variable\",\"Outfit\",system-ui,sans-serif;display:inline-flex;align-items:center;min-height:32px;padding:4px 10px;border-radius:999px;border:1px solid #34406f;background:#121835;color:#f1f4ff;font-size:13px;font-weight:600;cursor:pointer}.ds-chip:hover{background:#182042}.ds-chip[aria-pressed=true]{background:#ffc72c;border-color:#ffc72c;color:#0a0f24}.ds-chip:focus-visible{outline:3px solid #ffc72c;outline-offset:2px}"
    },
    {
      "name": "Shell Bar with Coin Balance",
      "kind": "nav",
      "refersTo": "shellbar",
      "description": "Sticky indigo bar: lockup, gold coin pill (no currency symbol), ghost sign-out.",
      "html": "<header class=\"ds-shell\"><span class=\"ds-lockup\">Naija <span>Hustle City</span></span><span class=\"ds-balance\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"9\" r=\"6\"/><path d=\"M18.1 10.4A6 6 0 1 1 10.4 18\"/></svg>2,000 <small>City Coins</small></span><button class=\"ds-shell-btn\">Sign out</button></header>",
      "css": ".ds-shell{font-family:\"Outfit Variable\",\"Outfit\",system-ui,sans-serif;display:flex;align-items:center;gap:12px;padding:10px 16px;background:#1e2a5e;color:#e9ecfb}.ds-lockup{flex:1;font-weight:850;font-size:20px;text-transform:uppercase;letter-spacing:.01em}.ds-lockup span{color:#ffc72c}.ds-balance{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;background:#ffc72c;color:#0a0f24;font-weight:750;font-variant-numeric:tabular-nums}.ds-balance small{font-weight:500;font-size:13px}.ds-shell-btn{font-family:\"Outfit Variable\",\"Outfit\",system-ui,sans-serif;min-height:36px;padding:6px 10px;border-radius:999px;border:1px solid rgb(233 236 251 / 30%);background:transparent;color:#e9ecfb;font-size:16px;cursor:pointer}.ds-shell-btn:hover{background:rgb(255 255 255 / 10%)}.ds-shell-btn:focus-visible{outline:3px solid #ffc72c;outline-offset:2px}"
    },
    {
      "name": "Selvedge Truth Strip",
      "kind": "custom",
      "refersTo": "selvedge",
      "description": "Gold-on-navy uppercase strip printing the surface's one rule.",
      "html": "<div class=\"ds-selvedge\"><span>City Coins are game money — no cash value</span><span aria-hidden=\"true\"><i></i>City Coins are game money — no cash value</span></div>",
      "css": ".ds-selvedge{font-family:\"Outfit Variable\",\"Outfit\",system-ui,sans-serif;display:flex;gap:28px;overflow:hidden;white-space:nowrap;padding:5px 16px;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;background:#0a0f24;color:#ffc72c}.ds-selvedge span{flex:none}.ds-selvedge i{display:inline-block;width:6px;height:6px;background:currentColor;transform:rotate(45deg) translateY(-2px);margin-right:22px;opacity:.7}"
    },
    {
      "name": "Ready Quest Bolt",
      "kind": "card",
      "refersTo": "place-plate",

  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default action: sheet with strong hairline, 44px, 650 weight.",
      "html": "<button class=\"ds-btn\">Find a business</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:\"Archivo Variable\",\"Archivo\",system-ui,sans-serif;font-size:16px;font-weight:650;min-height:44px;padding:9px 14px;border-radius:999px;border:1px solid var(--rule-strong,#b4bad6);background:var(--sheet,#fff);color:var(--text,#141833);cursor:pointer;transition:background .15s ease,transform .15s cubic-bezier(.16,1,.3,1)}.ds-btn:hover{background:var(--sheet-2,#e8eaf4)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid #f2b705;outline-offset:2px}.ds-btn:disabled{cursor:not-allowed;color:var(--muted,#4c5275);background:var(--sheet-2,#e8eaf4);border-color:var(--rule,#d3d7ea);filter:none}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Committing actions (Sign in, Collect, Buy). Indigo by day, yellow at night.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Collect</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:\"Archivo Variable\",\"Archivo\",system-ui,sans-serif;font-size:16px;font-weight:650;min-height:44px;padding:9px 14px;border-radius:999px;border:1px solid var(--rule-strong,#b4bad6);background:var(--sheet,#fff);color:var(--text,#141833);cursor:pointer;transition:background .15s ease,transform .15s cubic-bezier(.16,1,.3,1)}.ds-btn:hover{background:var(--sheet-2,#e8eaf4)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid #f2b705;outline-offset:2px}.ds-btn:disabled{cursor:not-allowed;color:var(--muted,#4c5275);background:var(--sheet-2,#e8eaf4);border-color:var(--rule,#d3d7ea);filter:none}.ds-btn-primary{background:var(--accent,#1f2a6b);border-color:var(--accent,#1f2a6b);color:var(--accent-ink,#fff)}.ds-btn-primary:hover{background:var(--accent,#1f2a6b);filter:brightness(1.12)}"
    },
    {
      "name": "Go Button",
      "kind": "button",
      "refersTo": "button-go",
      "description": "The action that earns coins or leaves for real merchants: Serve, Claim (when ready), Browse merchants.",
      "html": "<button class=\"ds-btn ds-btn-go\">Serve for 450</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:\"Archivo Variable\",\"Archivo\",system-ui,sans-serif;font-size:16px;font-weight:650;min-height:44px;padding:9px 14px;border-radius:999px;border:1px solid var(--rule-strong,#b4bad6);background:var(--sheet,#fff);color:var(--text,#141833);cursor:pointer;transition:background .15s ease,transform .15s cubic-bezier(.16,1,.3,1)}.ds-btn:hover{background:var(--sheet-2,#e8eaf4)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid #f2b705;outline-offset:2px}.ds-btn:disabled{cursor:not-allowed;color:var(--muted,#4c5275);background:var(--sheet-2,#e8eaf4);border-color:var(--rule,#d3d7ea);filter:none}.ds-btn-go{background:#f2b705;border-color:#f2b705;color:#2a1f00}.ds-btn-go:hover{background:#f2b705;filter:brightness(1.05)}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Label above, 44px input with strong hairline, flush yellow focus, muted hint.",
      "html": "<label class=\"ds-field\">Nickname<input class=\"ds-input\" value=\"Tunde_01\"><span class=\"ds-hint\">This is how other players see you.</span></label>",
      "css": ".ds-field{display:grid;gap:6px;font-family:\"Archivo Variable\",\"Archivo\",system-ui,sans-serif;font-weight:650;font-size:14px;color:var(--text,#141833)}.ds-input{font:inherit;font-weight:400;font-size:16px;min-height:44px;padding:10px 12px;border-radius:12px;border:1px solid var(--rule-strong,#b4bad6);background:var(--sheet,#fff);color:inherit}.ds-input:focus-visible{outline:3px solid #f2b705;outline-offset:0}.ds-hint{font-weight:400;font-size:13px;color:var(--muted,#4c5275)}"
    },
    {
      "name": "Shell Bar",
      "kind": "nav",
      "refersTo": "shellbar",
      "description": "Sticky indigo shell: print-swatch lockup, yellow coin pill, sign-out pill.",
      "html": "<header class=\"ds-shell\"><span class=\"ds-lockup\"><span class=\"ds-swatch\"></span><span class=\"ds-name\">Naija <span>Hustle City</span></span></span><span class=\"ds-balance\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"8\" cy=\"8\" r=\"6\"/><path d=\"M18.09 10.37A6 6 0 1 1 10.34 18\"/></svg>2,000 <small>City Coins</small></span><button class=\"ds-shell-btn\">Sign out</button></header>",
      "css": ".ds-shell{display:flex;align-items:center;gap:12px;padding:10px 16px;background:#1f2a6b;color:#e9ecfb;font-family:\"Archivo Variable\",\"Archivo\",system-ui,sans-serif}.ds-lockup{display:flex;align-items:center;gap:10px;flex:1}.ds-swatch{width:28px;height:28px;border-radius:6px;background-image:url(\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%2248%22%20height%3D%2248%22%20viewBox%3D%220%200%2048%2048%22%3E%3Crect%20width%3D%2248%22%20height%3D%2248%22%20fill%3D%22%23f2b705%22/%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%231f2a6b%22%20stroke-width%3D%223%22%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%229%22/%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%224.5%22/%3E%3Ccircle%20cx%3D%2236%22%20cy%3D%2236%22%20r%3D%229%22/%3E%3Ccircle%20cx%3D%2236%22%20cy%3D%2236%22%20r%3D%224.5%22/%3E%3C/g%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%221.8%22%20fill%3D%22%23c8321e%22/%3E%3Ccircle%20cx%3D%2236%22%20cy%3D%2236%22%20r%3D%221.8%22%20fill%3D%22%23c8321e%22/%3E%3Cpath%20d%3D%22M30%206l6%206-6%206-6-6zM6%2030l6%206-6%206-6-6zM54%2030l-6%206%206%206z%22%20fill%3D%22%23c8321e%22/%3E%3C/svg%3E\");background-size:28px 28px;box-shadow:inset 0 0 0 2px rgb(255 255 255/25%)}.ds-name{font-weight:850;font-stretch:75%;font-size:20px;letter-spacing:.01em;text-transform:uppercase}.ds-name span{color:#f2b705}.ds-balance{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;background:#f2b705;color:#2a1f00;font-weight:750;font-variant-numeric:tabular-nums}.ds-balance small{font-weight:500;font-size:13px}.ds-shell-btn{font:inherit;background:transparent;color:#e9ecfb;border:1px solid rgb(233 236 251/30%);border-radius:999px;padding:6px 10px;min-height:36px;cursor:pointer}.ds-shell-btn:hover{background:rgb(255 255 255/10%)}.ds-shell-btn:focus-visible{outline:3px solid #f2b705;outline-offset:2px}"
    },
    {
      "name": "Segmented Tabs",
      "kind": "nav",
      "refersTo": "segmented",
      "description": "Pill track with accent selected tab; Market Square and auth.",
      "html": "<div class=\"ds-seg\" role=\"tablist\"><button role=\"tab\" aria-selected=\"true\">My shop</button><button role=\"tab\" aria-selected=\"false\">Real businesses</button></div>",
      "css": ".ds-seg{display:inline-grid;grid-auto-flow:column;gap:4px;padding:4px;border-radius:999px;background:var(--sheet-2,#e8eaf4);font-family:\"Archivo Variable\",\"Archivo\",system-ui,sans-serif}.ds-seg button{font:inherit;font-weight:650;border:0;background:transparent;border-radius:999px;padding:8px 16px;min-height:40px;color:var(--muted,#4c5275);cursor:pointer}.ds-seg button[aria-selected=true]{background:var(--accent,#1f2a6b);color:var(--accent-ink,#fff);box-shadow:0 1px 2px rgb(20 24 51/8%),0 8px 24px -8px rgb(20 24 51/18%)}.ds-seg button:focus-visible{outline:3px solid #f2b705;outline-offset:2px}"
    },
    {
      "name": "Tags",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Near-square uppercase labels; yellow marks demo listings.",
      "html": "<span class=\"ds-tag\">Food</span> <span class=\"ds-tag ds-tag-demo\">Demo listing</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;font-family:\"Archivo Variable\",\"Archivo\",system-ui,sans-serif;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:2px 8px;border-radius:4px;background:var(--sheet-2,#e8eaf4);color:var(--muted,#4c5275)}.ds-tag-demo{background:#f2b705;color:#2a1f00}"
    },
    {
      "name": "Selvedge",
      "kind": "custom",
      "refersTo": "selvedge",
      "description": "The printed edge of the cloth: one rule per surface, repeats decorative.",
      "html": "<div class=\"ds-selvedge\"><span>City Coins are game money \u2014 no cash value</span><span aria-hidden=\"true\"><i></i>City Coins are game money \u2014 no cash value</span><span aria-hidden=\"true\"><i></i>City Coins are game money \u2014 no cash value</span></div>",
      "css": ".ds-selvedge{display:flex;gap:28px;overflow:hidden;white-space:nowrap;padding:5px 16px;font-family:\"Archivo Variable\",\"Archivo\",system-ui,sans-serif;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;background:#141c4d;color:#f2b705}.ds-selvedge span{flex:none}.ds-selvedge i{display:inline-block;width:6px;height:6px;background:currentColor;transform:rotate(45deg) translateY(-2px);margin-right:22px;opacity:.7}"
    },
    {
      "name": "Place Header",
      "kind": "card",
      "refersTo": "place-plate",
      "description": "The place's print in a raised cloth frame, plate with the name, selvedge along the edge.",
      "html": "<div class=\"ds-cloth\"><div class=\"ds-head\"><button class=\"ds-back\">\u2190 Map</button><div class=\"ds-plate\"><h1>Work Hub</h1><p>Paid digital tasks from funded businesses.</p></div></div><div class=\"ds-selvedge2\">Jobs pay only when a business has funded them \u2014 nothing here pays yet</div></div>",
      "css": ".ds-cloth{border-radius:14px;overflow:hidden;border:1px solid var(--rule,#d3d7ea);box-shadow:0 1px 2px rgb(20 24 51/8%),0 8px 24px -8px rgb(20 24 51/18%);font-family:\"Archivo Variable\",\"Archivo\",system-ui,sans-serif}.ds-head{min-height:132px;display:flex;flex-direction:column;justify-content:space-between;align-items:flex-start;gap:16px;padding:12px 16px 16px;background-image:url(\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%2248%22%20height%3D%2248%22%20viewBox%3D%220%200%2048%2048%22%3E%3Crect%20width%3D%2248%22%20height%3D%2248%22%20fill%3D%22%231f2a6b%22/%3E%3Cg%20fill%3D%22%231e7a46%22%3E%3Crect%20x%3D%222%22%20y%3D%224%22%20width%3D%2220%22%20height%3D%228%22%20rx%3D%221%22/%3E%3Crect%20x%3D%2226%22%20y%3D%2216%22%20width%3D%2220%22%20height%3D%228%22%20rx%3D%221%22/%3E%3Crect%20x%3D%222%22%20y%3D%2228%22%20width%3D%2220%22%20height%3D%228%22%20rx%3D%221%22/%3E%3Crect%20x%3D%2226%22%20y%3D%2240%22%20width%3D%2220%22%20height%3D%228%22%20rx%3D%221%22/%3E%3C/g%3E%3Cg%20stroke%3D%22%23f2b705%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%3E%3Cpath%20d%3D%22M30%206v4M36%206v4M42%206v4M6%2018v4M12%2018v4M18%2018v4M30%2030v4M36%2030v4M42%2030v4M6%2042v4M12%2042v4M18%2042v4%22/%3E%3C/g%3E%3C/svg%3E\");background-size:48px 48px}.ds-back{font:inherit;font-size:14px;font-weight:650;min-height:36px;padding:6px 10px;border-radius:10px;border:1px solid var(--rule-strong,#b4bad6);background:var(--sheet,#fff);color:var(--text,#141833);cursor:pointer}.ds-back:focus-visible{outline:3px solid #f2b705;outline-offset:2px}.ds-plate{background:var(--sheet,#fff);color:var(--text,#141833);border-radius:10px;padding:10px 14px;box-shadow:0 1px 2px rgb(20 24 51/8%),0 8px 24px -8px rgb(20 24 51/18%)}.ds-plate h1{margin:0;font-size:28px;font-weight:800;font-stretch:88%;letter-spacing:-.01em;line-height:1.15}.ds-plate p{margin:0;font-size:14px;color:var(--muted,#4c5275)}.ds-selvedge2{padding:5px 16px;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;background:#141c4d;color:#f2b705;white-space:nowrap;overflow:hidden}"
    },
    {
      "name": "Timed-State Bar",
      "kind": "custom",
      "refersTo": "timebar",
      "description": "Exact remaining time as a shrinking bar plus tabular countdown.",
      "html": "<div class=\"ds-time\"><div class=\"ds-cap\"><span>Customer waits for</span><span>4:32 left</span></div><div class=\"ds-track\"><div class=\"ds-fill\"></div></div></div>",
      "css": ".ds-time{display:grid;gap:4px;font-family:\"Archivo Variable\",\"Archivo\",system-ui,sans-serif;max-width:320px}.ds-cap{display:flex;justify-content:space-between;font-size:12px;color:var(--muted,#4c5275);font-variant-numeric:tabular-nums}.ds-track{height:6px;border-radius:3px;background:var(--sheet-2,#e8eaf4);overflow:hidden}.ds-fill{height:100%;width:100%;background:#1f2a6b;border-radius:3px;transform-origin:left;transform:scaleX(.62);transition:transform 1s linear}"
    },
    {
      "name": "Quest Bolt (ready)",
      "kind": "custom",
      "refersTo": "bolt-plate-ready",
      "description": "Quest plate over its place's print; the cloth unrolls and the plate lifts when claimable.",
      "html": "<div class=\"ds-bolt\"><div class=\"ds-bolt-cloth\"></div><div class=\"ds-bolt-plate\"><div class=\"ds-row\"><strong>Serve 3 customers</strong><span class=\"ds-reward\">+150</span></div><div class=\"ds-bar\"><span></span></div><div class=\"ds-row\"><span>3 / 3</span><button class=\"ds-claim\">Claim</button></div></div></div>",
      "css": ".ds-bolt{position:relative;padding:8px;isolation:isolate;font-family:\"Archivo Variable\",\"Archivo\",system-ui,sans-serif;max-width:340px}.ds-bolt-cloth{position:absolute;inset:0;z-index:-1;border-radius:12px;background-image:url(\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%2248%22%20height%3D%2248%22%20viewBox%3D%220%200%2048%2048%22%3E%3Crect%20width%3D%2248%22%20height%3D%2248%22%20fill%3D%22%23f2b705%22/%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%231f2a6b%22%20stroke-width%3D%223%22%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%229%22/%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%224.5%22/%3E%3Ccircle%20cx%3D%2236%22%20cy%3D%2236%22%20r%3D%229%22/%3E%3Ccircle%20cx%3D%2236%22%20cy%3D%2236%22%20r%3D%224.5%22/%3E%3C/g%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%221.8%22%20fill%3D%22%23c8321e%22/%3E%3Ccircle%20cx%3D%2236%22%20cy%3D%2236%22%20r%3D%221.8%22%20fill%3D%22%23c8321e%22/%3E%3Cpath%20d%3D%22M30%206l6%206-6%206-6-6zM6%2030l6%206-6%206-6-6zM54%2030l-6%206%206%206z%22%20fill%3D%22%23c8321e%22/%3E%3C/svg%3E\");background-size:32px 32px;clip-path:inset(0 100% 0 0);transition:clip-path .9s cubic-bezier(.16,1,.3,1)}.ds-bolt:hover .ds-bolt-cloth,.ds-bolt:focus-within .ds-bolt-cloth{clip-path:inset(0 0 0 0)}.ds-bolt-plate{display:grid;gap:8px;padding:10px 12px;border-radius:10px;background:var(--sheet,#fff);box-shadow:0 1px 2px rgb(20 24 51/8%),0 8px 24px -8px rgb(20 24 51/18%);color:var(--text,#141833)}.ds-row{display:flex;justify-content:space-between;align-items:center;font-variant-numeric:tabular-nums}.ds-reward{font-weight:750;color:var(--coin,#8a6400)}.ds-bar{height:8px;border-radius:4px;background:var(--sheet-2,#e8eaf4);overflow:hidden}.ds-bar span{display:block;height:100%;background:#1e7a46}.ds-claim{font:inherit;font-size:14px;font-weight:650;min-height:36px;padding:6px 10px;border-radius:10px;border:1px solid #f2b705;background:#f2b705;color:#2a1f00;cursor:pointer}.ds-claim:hover{filter:brightness(1.05)}.ds-claim:focus-visible{outline:3px solid #f2b705;outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "Wax-Print Selvedge",
    "overview": "Every place in Junction 101 is its own bolt of wax-print cloth, and the selvedge, the printed edge of the cloth, prints the truth. The shell is indigo-dyed; three authored two-colour repeats in cadmium yellow, madder red, leaf green and indigo give Market Square, Work Hub and The Hangout their own cloth. Everything that is not cloth sits flat on a pale indigo-white ground, divided by hairlines. The world refuses the fintech default of white cards on grey with one green accent.\n\nThe type is one variable grotesque, Archivo, used for display and data alike; its width axis does the expressive work (condensed and uppercase for the name and the welcome, slightly narrowed for headings, full width for reading). Numbers are tabular and right-aligned so coin amounts, stock and countdowns read like a ledger. Light mode is the default because the player holds a mid-range Android outdoors in Lagos daylight; an indigo-dyed night mode follows the system preference.\n\nTruth is carried by structure, not decoration: a single printed rule on each surface's selvedge says what is real (coins have no cash value; jobs pay only when funded), timed states are bars of exact remaining time, and quest bolts unroll their cloth only when there is something to claim.",
    "keyCharacteristics": [
      "Indigo shell, yellow coin balance, cloth only where a place is.",
      "Three authored wax-print tiles, one per place, reused as CSS backgrounds and SVG pattern fills.",
      "One selvedge per surface, stating that surface's one rule.",
      "Hairlines on the ground; only the cloth (map, place header, welcome cloth) is raised.",
      "Archivo Variable with the `wdth` axis as the display voice; tabular numerals throughout.",
      "Bars, not spinners or badges, for time and progress."
    ],
    "rules": [
      {
        "name": "The Dye Lot Rule",
        "body": "Saturated colour comes from the cloth: indigo, yellow, red and green appear in the shell, the prints, the coin and the one \"go\" action per moment. Everything else is ground, sheet, ink and hairline.",
        "section": "colors"
      },
      {
        "name": "The Coins-Are-Yellow Rule",
        "body": "Cadmium yellow marks City Coins and the action that earns them. Real-money prices (naira, merchants) are set in plain ink, never yellow.",
        "section": "colors"
      },
      {
        "name": "The One Hand Rule",
        "body": "Archivo Variable is the only family. Hierarchy comes from weight (400\u2013900) and the `wdth` axis (70\u2013100%), never a second face.",
        "section": "typography"
      },
      {
        "name": "The Ledger Rule",
        "body": "Numbers are tabular everywhere and right-aligned in columns (stock, cost, price, coins, standings, countdowns).",
        "section": "typography"
      },
      {
        "name": "The Hairline-on-Ground Rule",
        "body": "Sections sit directly on the ground and are divided by 1px hairlines (rule between rows, rule-strong above a section). There are no cards: if something needs a box, it is either cloth or a plate on cloth.",
        "section": "layout"
      },
      {
        "name": "The Only-Cloth-Is-Raised Rule",
        "body": "A section, list, table or form never gets a shadow. Lift is reserved for cloth and the plates set on it.",
        "section": "elevation"
      },
      {
        "name": "The Print Tile Rule",
        "body": "The three prints are authored 48\u00d748 tiles in the cloth palette, rendered as CSS backgrounds (place header at 48px, welcome cloth at 64px, quest bolts at 32px, lockup swatch at 28px) and as SVG patterns at 0.6 scale on the map. New places get a new authored tile, not a recolour of an existing one.",
        "section": "shapes"
      },
      {
        "name": "The One Selvedge Rule",
        "body": "One rule per surface, on the cloth's edge. The map view, the browse page and the welcome cloth carry one each; inside a place, the place header's selvedge replaces the shell's. The rule is a true constraint of that surface (coins have no cash value; customers walk if the price is too high; jobs pay only when funded; standings count coins), never a slogan.",
        "section": "components"
      },
      {
        "name": "The Exact Time Rule",
        "body": "Anything that expires is shown as a bar of the real remaining time plus the countdown in figures, never as a vague badge.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** give every new place its own authored wax-print tile in the cloth palette and use it on its header, its map building and its quests.",
      "**Do** put exactly one selvedge on each surface, stating one true rule of that surface.",
      "**Do** keep sections flat on the ground, divided by hairlines; raise only cloth and the plates set on it.",
      "**Do** show anything that expires as a timed-state bar with an exact tabular countdown.",
      "**Do** reserve cadmium yellow for coins, the \"go\" action and the focus ring; set real-money prices in plain ink.",
      "**Do** set every number in tabular figures, right-aligned in columns.",
      "**Do** use Archivo's width axis and weight for hierarchy instead of another typeface."
    ],
    "donts": [
      "**Don't** build white cards on grey with one green accent; this world's surfaces are cloth or hairline-divided ground.",
      "**Don't** add a second selvedge, or use the selvedge for marketing copy.",
      "**Don't** use madder red or leaf green as error and success colours; status uses the ok and danger tokens.",
      "**Don't** show a spinner or vague badge where a remaining time is known.",
      "**Don't** recolour an existing print to make a new place."
    ]
  }
}
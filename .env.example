# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgres://hustle:hustle@localhost:5433/hustle_city
REDIS_URL=redis://localhost:6380
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=hustle
S3_SECRET_KEY=hustle-dev-secret
S3_BUCKET=hustle-uploads

API_PORT=4180
# Comma-separated list of allowed web origins (dev uses the Vite proxy, so same-origin)
WEB_ORIGIN=http://localhost:5190
# Set true behind TLS so session cookies are Secure
COOKIE_SECURE=false

# Game configuration
GAME_TIMEZONE=Africa/Lagos
STARTING_COINS=2000

# Local-only dev admin created by `pnpm db:seed`. Test values; never reuse elsewhere.
DEV_ADMIN_EMAIL=admin@hustle.test
DEV_ADMIN_PASSWORD=local-dev-admin-change-me
